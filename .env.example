# Copy this file to .env for local dev (npm run dev), and add the same two
# keys under Netlify → Site configuration → Environment variables for the
# deployed build. Both are the PUBLIC "anon" key pair from your Supabase
# project (Project Settings → API) — safe to expose in a browser bundle.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
